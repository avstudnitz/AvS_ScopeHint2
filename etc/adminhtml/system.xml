<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="dev">
            <group id="debug">
                <field id="show_path_in_adminhtml" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="0" showInStore="0" canRestore="1">
                    <label>Display path for each option in system configuration</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="show_attribute_code_in_adminhtml" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="0" showInStore="0" canRestore="1">
                    <label>Display attribute code for each field in the product edit</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="scopehint_legacy_tooltip" translate="label comment" type="select" sortOrder="20" showInDefault="1" showInWebsite="0" showInStore="0" canRestore="1">
                    <label>Use legacy scopehint tooltip (deprecated)</label>
                    <comment>When enabled, scope overrides are shown as a plain line-break-separated list instead of the grouped expandable popover. Provided for one release-cycle rollback.</comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="scopehint_max_stores" translate="label comment" type="text" sortOrder="30" showInDefault="1" showInWebsite="0" showInStore="0" canRestore="1">
                    <label>Maximum stores for scope hint detection</label>
                    <comment>Maximum number of store views for which EAV override detection runs on the category edit form. Set to 0 to use the default (50). Detection is skipped and a warning is logged when the store count exceeds this value.</comment>
                </field>
            </group>
        </section>
    </system>
</config>
