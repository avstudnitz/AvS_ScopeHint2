<?php
/**
 * @var \AvS\ScopeHint\Block\Adminhtml\Eav\Popover $block
 */
$overrides    = $block->getOverrides();
$totalCount   = $block->getTotalCount();
$expandAll    = $block->shouldExpandAll();
$showSearch   = $block->shouldShowSearch();
$panelId      = $block->escapeHtmlAttr($block->getFieldHtmlId());
$panelLabel   = $block->escapeHtmlAttr((string) __('%1 scope overrides', $totalCount));
$triggerLabel = $block->escapeHtmlAttr((string) __('%1 scope overrides — click to expand', $totalCount));
?>
<?php if ($overrides && !$overrides->isEmpty()): ?>
<div class="scopehint-popover" data-scopehint-popover="1">
    <button type="button"
            class="scopehint-trigger"
            aria-expanded="false"
            aria-controls="<?= $panelId ?>"
            aria-label="<?= $triggerLabel ?>">
        <span class="scopehint-badge"><?= (int) $totalCount ?></span>
    </button>
    <div class="scopehint-panel"
         id="<?= $panelId ?>"
         role="dialog"
         aria-modal="false"
         aria-label="<?= $panelLabel ?>"
         hidden>
        <header class="scopehint-panel-header">
            <?php if ($showSearch): ?>
            <input type="search"
                   class="scopehint-search"
                   placeholder="<?= $block->escapeHtmlAttr((string) __('Filter…')) ?>"
                   aria-label="<?= $block->escapeHtmlAttr((string) __('Filter scope overrides')) ?>">
            <?php endif; ?>
            <button type="button"
                    class="scopehint-close"
                    aria-label="<?= $block->escapeHtmlAttr((string) __('Close')) ?>">&#x00D7;</button>
        </header>
        <ul class="scopehint-websites">
            <?php foreach ($overrides->getOverridesByWebsite() as $websiteCode => $websiteOverrides): ?>
            <?php
                $websiteCode  = (string) $websiteCode;
                $storeCount   = count($websiteOverrides);
                $summaryLabel = $block->escapeHtml(
                    (string) __('Website: %1 (%2 override(s))', $websiteCode, $storeCount)
                );
            ?>
            <li data-website-code="<?= $block->escapeHtmlAttr($websiteCode) ?>">
                <details<?= $expandAll ? ' open' : '' ?>>
                    <summary><?= $summaryLabel ?></summary>
                    <ul>
                        <?php foreach ($websiteOverrides as $override): ?>
                        <li data-store-code="<?= $block->escapeHtmlAttr($override->getScopeCode()) ?>">
                            <div class="scopehint-store-meta">
                                <span class="scopehint-store-name"><?= $block->escapeHtml($override->getScopeName()) ?></span>
                                <code class="scopehint-store-code"><?= $block->escapeHtml($override->getScopeCode()) ?></code>
                            </div>
                            <div class="scopehint-store-value"><?= $block->escapeHtml($override->getDisplayValue()) ?></div>
                        </li>
                        <?php endforeach; ?>
                    </ul>
                </details>
            </li>
            <?php endforeach; ?>
        </ul>
    </div>
</div>
<?php endif; ?>
