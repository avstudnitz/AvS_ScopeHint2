{
    "name": "avstudnitz/scopehint2",
    "description": "Displays a hint when a configuration value is overwritten on a lower scope (website or store view).",
    "require": {
        "php": "^8.1",
        "magento/framework": "~103.0",
        "magento/module-config": "~101.2",
        "magento/module-store": "~101.1",
        "magento/module-backend": "~102.0",
        "magento/module-catalog": "~104.0",
        "magento/module-ui": "~101.2"
    },
    "require-dev": {
        "phpstan/phpstan": "^1.10",
        "phpunit/phpunit": "^9.5",
        "magento/magento-coding-standard": "*",
        "bitexpert/phpstan-magento": "^0.11"
    },
    "type": "magento2-module",
    "license": [
        "OSL-3.0"
    ],
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "AvS\\ScopeHint\\": ""
        }
    },
    "repositories": {
        "mage-os-mirror": {
            "type": "composer",
            "url": "https://mirror.mage-os.org/"
        }
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "magento/composer-dependency-version-audit-plugin": false,
            "magento/magento-composer-installer": false
        }
    }
}
